msgstr "Chybí token Fio API."

#: includes/class-pmfio-api.php:25
msgid "Fio allows one request per 30 seconds, please try again in a moment."
msgstr "Fio dovolí jeden dotaz za 30 sekund, zkuste to prosím za chvíli."

#. translators: %s: error message
#: includes/class-pmfio-api.php:34
#, php-format
msgid "Connection to Fio failed: %s"
msgstr "Spojení s Fio selhalo: %s"

