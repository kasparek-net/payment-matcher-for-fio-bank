msgstr "Jak získat token"

#: includes/class-pmfio-admin.php:601
msgid "Official Fio guide with a screenshot (PDF, in Czech, pages 4–5)"
msgstr "Oficiální návod Fio se screenshotem (PDF, strany 4–5)"

#: includes/class-pmfio-admin.php:601
msgid "Keep the token private: anyone who has it can read the account’s movements. You can delete it in internet banking at any time."
msgstr "Token nikomu neposílejte: kdo ho má, vidí pohyby na účtu. V internetovém bankovnictví ho můžete kdykoli smazat."

#: includes/class-pmfio-admin.php:618
msgid "turned off in WooCommerce"
msgstr "ve WooCommerce vypnutá"

#: includes/class-pmfio-admin.php:622
msgid "not installed"
