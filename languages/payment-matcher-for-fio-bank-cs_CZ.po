#: includes/class-pmfio-admin.php:581
#: includes/class-pmfio-admin.php:600
#: includes/class-pmfio-qr-payment.php:114
#, php-format
msgid "Order %s"
msgstr "Objednávka %s"

#: includes/class-pmfio-admin.php:589
msgid "QR payment (QR Platba)"
msgstr "QR platba"

#: includes/class-pmfio-admin.php:590
msgid "A QR code with the account, amount and variable symbol for unpaid bank-transfer orders. Czech and Slovak banking apps fill in the payment automatically. Generated on your server, no external service."
msgstr "QR kód s účtem, částkou a variabilním symbolem u nezaplacených objednávek na převod. České a slovenské bankovní aplikace platbu vyplní samy. Generuje se na vašem serveru, bez cizí služby."

#: includes/class-pmfio-admin.php:592
msgid "Thank-you page after the order"
msgstr "Děkovná stránka po objednávce"

#: includes/class-pmfio-admin.php:593
msgid "Order e-mails to the customer (including the payment reminder)"
msgstr "E-maily objednávky zákazníkovi (včetně připomínky platby)"

#: includes/class-pmfio-admin.php:594
msgid "Show QR code"
msgstr "Zobrazit QR kód"

#: includes/class-pmfio-admin.php:594
msgid "Turn off if another plugin or your theme already shows a QR code, so customers do not see two."
msgstr "Vypněte, pokud QR kód už ukazuje jiný plugin nebo šablona, ať zákazník nevidí dva."

#. translators: %s: IBAN
#: includes/class-pmfio-admin.php:597
#, php-format
msgid "Empty = taken from the bank-transfer account in WooCommerce: %s"
msgstr "Prázdné = převezme se účet pro bankovní převod ve WooCommerce: %s"

#. translators: %s: IBAN
#: includes/class-pmfio-admin.php:597
msgid "Empty = taken from the bank-transfer account in WooCommerce (Settings → Payments → Direct bank transfer)."
msgstr "Prázdné = převezme se účet pro bankovní převod ve WooCommerce (Nastavení → Platby → Bankovní převod)."

#: includes/class-pmfio-admin.php:598
msgid "IBAN"
msgstr "IBAN"

#. translators: %s: placeholder
#: includes/class-pmfio-admin.php:600
msgid "Message for recipient"
msgstr "Zpráva pro příjemce"

#. translators: %s: placeholder
#: includes/class-pmfio-admin.php:600
#, php-format
msgid "Up to 60 characters, without diacritics in the bank. You can use %s."
msgstr "Nejvýš 60 znaků, v bance bez diakritiky. Lze použít %s."

#: includes/class-pmfio-admin.php:604
msgid "Preview"
msgstr "Náhled"

#: includes/class-pmfio-admin.php:608
msgid "Sample order. Try scanning it in your banking app, but do not confirm the payment."
msgstr "Ukázková objednávka. Zkuste kód naskenovat v bankovní aplikaci, platbu ale nepotvrzujte."

#: includes/class-pmfio-admin.php:610
msgid "No valid account. Fill in the IBAN or the bank-transfer account in WooCommerce."
msgstr "Chybí platný účet. Vyplňte IBAN nebo účet pro bankovní převod ve WooCommerce."

#: includes/class-pmfio-admin.php:614
msgid "Save QR settings"
msgstr "Uložit nastavení QR"

#: includes/class-pmfio-api.php:22
msgid "The Fio API token is missing."
msgstr "Chybí token Fio API."

#: includes/class-pmfio-api.php:25
msgid "Fio allows one request per 30 seconds, please try again in a moment."
msgstr "Fio dovolí jeden dotaz za 30 sekund, zkuste to prosím za chvíli."

#. translators: %s: error message
#: includes/class-pmfio-api.php:34
#, php-format
msgid "Connection to Fio failed: %s"
msgstr "Spojení s Fio selhalo: %s"

#: includes/class-pmfio-api.php:44
msgid "Fio returned an unexpected response."
msgstr "Fio vrátilo neočekávanou odpověď."

#: includes/class-pmfio-api.php:54
msgid "Fio: requests too frequent (limit is one request per 30 seconds per token)."
msgstr "Fio: příliš časté dotazy (limit je jeden dotaz za 30 sekund na token)."

#: includes/class-pmfio-api.php:56
msgid "Fio: the token does not exist or has expired. Extend it or create a new one in Fio internet banking (Settings → API)."
msgstr "Fio: token neexistuje nebo vypršel. Prodlužte ho nebo vytvořte nový v internetovém bankovnictví (Nastavení → API)."

#: includes/class-pmfio-api.php:58
msgid "Fio: data older than 90 days requires authorisation in internet banking."
msgstr "Fio: data starší 90 dní vyžadují autorizaci v internetovém bankovnictví."

#: includes/class-pmfio-api.php:60
msgid "Fio: too many movements, reduce the number of days to look back."
msgstr "Fio: příliš mnoho pohybů, snižte počet dní zpět."

#: includes/class-pmfio-api.php:62
msgid "Fio: malformed request (404)."
msgstr "Fio: chybný dotaz (404)."

#. translators: %d: HTTP status code
#: includes/class-pmfio-api.php:65
#, php-format
