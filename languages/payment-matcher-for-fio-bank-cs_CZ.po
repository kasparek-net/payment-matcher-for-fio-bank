#: includes/class-pmfio-admin.php:566
msgid "Privacy Policy Guide"
msgstr "průvodci zásadami ochrany osobních údajů"

#: includes/class-pmfio-admin.php:567
msgid "Keep payments for"
msgstr "Uchovávat platby"

#: includes/class-pmfio-admin.php:567
msgid "months"
msgstr "měsíců"

#: includes/class-pmfio-admin.php:571
msgid "Save settings"
msgstr "Uložit nastavení"

